on post-fs-data

    #######################################################################
    # 🔇 REDUCE LOGGING OVERHEAD (SAFE + STABLE)
    #######################################################################
    stop logd
    stop statsd
    stop traced
    stop bugreportd

    setprop persist.sys.logd.enable 0
    setprop log.tag.statsd S
    setprop log.tag.GAv4 S
    setprop log.tag.GmsClient S

    #######################################################################
    # ❌ BACKGROUND SERVICES (ONLY NON-CRITICAL)
    #######################################################################
    stop samsunganalytics
    stop diagmonagent
    stop knox_enrollment_service
    stop knox_push_service

    stop printspooler

    # DO NOT permanently kill game services on MTK (prevents instability)
    # Only allow system to manage them dynamically

    #######################################################################
    # 🚀 CPU SCHEDULER (BALANCED RESPONSIVENESS)
    #######################################################################
    write /proc/sys/kernel/sched_autogroup_enabled 0
    write /proc/sys/kernel/sched_latency_ns 10000000
    write /proc/sys/kernel/sched_min_granularity_ns 3000000
    write /proc/sys/kernel/sched_wakeup_granularity_ns 3000000
    write /proc/sys/kernel/sched_migration_cost_ns 750000

    #######################################################################
    # 🧠 MEMORY (BALANCED + LESS STANDBY DRAIN)
    #######################################################################
    write /proc/sys/vm/swappiness 20
    write /proc/sys/vm/dirty_ratio 25
    write /proc/sys/vm/dirty_background_ratio 10
    write /proc/sys/vm/vfs_cache_pressure 70
    write /proc/sys/vm/stat_interval 15

    #######################################################################
    # ⚡ STORAGE (BALANCED FAST LOAD + BATTERY FRIENDLY)
    #######################################################################
    write /sys/block/sda/queue/read_ahead_kb 256
    write /sys/block/sda/queue/nr_requests 128

    write /sys/block/mmcblk0/queue/read_ahead_kb 256
    write /sys/block/mmcblk0/queue/nr_requests 128

    #######################################################################
    # 📶 NETWORK (STABLE LOW LATENCY)
    #######################################################################
    write /proc/sys/net/ipv4/tcp_low_latency 1
    write /proc/sys/net/ipv4/tcp_timestamps 1
    write /proc/sys/net/ipv4/tcp_sack 1

    #######################################################################
    # 🎮 INPUT RESPONSIVENESS (SAFE TUNING)
    #######################################################################
    write /proc/sys/kernel/sched_tunable_scaling 0

    #######################################################################
    # 🔋 POWER POLICY (IMPORTANT CHANGE FOR BATTERY LIFE)
    #######################################################################
    setprop persist.sys.performance_mode 0
    setprop debug.performance.tuning 1

    # DO NOT force GAME mode globally
    # Let system switch dynamically instead of locking it
    setprop vendor.powerhal.state BALANCED


on property:sys.boot_completed=1

    #######################################################################
    # 🔁 STABILIZE AFTER BOOT
    #######################################################################
    stop logd
    stop statsd

    write /proc/sys/vm/swappiness 20

    setprop persist.sys.performance_mode 0
    setprop vendor.powerhal.state BALANCED
